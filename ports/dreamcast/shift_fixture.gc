;; Native 64-bit shift probes through original typed IR (AI-assisted).
(defun dc-shift-left ((value int) (amount int)) (shl value amount))
(defun dc-shift-logical ((value int) (amount int)) (shr value amount))
(defun dc-shift-arithmetic ((value int) (amount int)) (sar value amount))
(defun dc-shift-self ((value int)) (shl value value))
(defun dc-shift-mix ((value int) (amount int))
  (let ((live (logxor value #x1020304050607080)))
    (logxor (dc-shift-left value amount) (dc-shift-arithmetic live amount))))
(defun dc-shift-left-0 ((value int)) (shl value 0))
(defun dc-shift-left-1 ((value int)) (shl value 1))
(defun dc-shift-left-31 ((value int)) (shl value 31))
(defun dc-shift-left-32 ((value int)) (shl value 32))
(defun dc-shift-left-63 ((value int)) (shl value 63))
(defun dc-shift-logical-0 ((value int)) (shr value 0))
(defun dc-shift-logical-1 ((value int)) (shr value 1))
(defun dc-shift-logical-31 ((value int)) (shr value 31))
(defun dc-shift-logical-32 ((value int)) (shr value 32))
(defun dc-shift-logical-63 ((value int)) (shr value 63))
(defun dc-shift-arithmetic-0 ((value int)) (sar value 0))
(defun dc-shift-arithmetic-1 ((value int)) (sar value 1))
(defun dc-shift-arithmetic-31 ((value int)) (sar value 31))
(defun dc-shift-arithmetic-32 ((value int)) (sar value 32))
(defun dc-shift-arithmetic-63 ((value int)) (sar value 63))
