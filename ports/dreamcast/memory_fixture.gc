;; AI-assisted typed-memory probes, not original gameplay.
(defun dc-mem-car ((p object)) (car p))
(defun dc-mem-cdr ((p object)) (cdr p))
(defun dc-mem-set-car ((p object) (value object)) (set! (car p) value))
(defun dc-mem-set-cdr ((p object) (value object)) (set! (cdr p) value))
(defun dc-mem-load-i8 ((p (pointer int8))) (-> p))
(defun dc-mem-load-u8 ((p (pointer uint8))) (-> p))
(defun dc-mem-load-i16 ((p (pointer int16))) (-> p))
(defun dc-mem-load-u16 ((p (pointer uint16))) (-> p))
(defun dc-mem-load-i32 ((p (pointer int32))) (-> p))
(defun dc-mem-load-u32 ((p (pointer uint32))) (-> p))
(defun dc-mem-load-i64 ((p (pointer int64))) (-> p))
(defun dc-mem-load-u64 ((p (pointer uint64))) (-> p))
(defun dc-mem-store-u8 ((p (pointer uint8)) (value uint)) (set! (-> p) value))
(defun dc-mem-store-u16 ((p (pointer uint16)) (value uint)) (set! (-> p) value))
(defun dc-mem-store-u32 ((p (pointer uint32)) (value uint)) (set! (-> p) value))
(defun dc-mem-store-u64 ((p (pointer uint64)) (value uint)) (set! (-> p) value))
(defun dc-mem-load-float ((p (pointer float))) (-> p))
(defun dc-mem-store-float ((p (pointer float))) (set! (-> p) (-> p 1)))
(defun dc-mem-type ((p basic)) (-> p type))
(defun dc-mem-offset ((p (pointer uint32))) (-> p 80))
