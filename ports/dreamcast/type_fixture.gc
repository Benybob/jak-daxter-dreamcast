;; Original deftype/defmethod compiler path, synthetic class (AI-assisted).
(define-extern dc-c-basic-new (function symbol type basic))
(deftype dc-native-record (basic)
  ((value int32))
  (:methods
    (new (symbol type int) _type_)
    (score (_type_) int))
  :no-inspect)
(defmethod new dc-native-record ((heap symbol) (type type) (value int))
  (let ((self (the-as dc-native-record (dc-c-basic-new heap type))))
    (set! (-> self value) value)
    self))
(defmethod score dc-native-record ((self dc-native-record))
  (+ (-> self value) 9))
(deftype dc-native-child (dc-native-record)
  ((extra int32))
  :no-inspect)
(defun dc-type-create ((value int)) (new 'global 'dc-native-record value))
(defun dc-type-child ((value int)) (new 'global 'dc-native-child value))
(defun dc-type-read ((self dc-native-record)) (-> self value))
(defun dc-type-write ((self dc-native-record) (value int))
  (set! (-> self value) value)
  (none))
(defun dc-type-score ((self dc-native-record)) (score self))
(defun dc-type-of ((self dc-native-record)) (-> self type))
(defun dc-type-alternate ((self dc-native-record)) (+ (-> self value) 100))
(defun dc-type-install ((owner type) (index int) (implementation function))
  (method-set! owner index implementation))
(none)
