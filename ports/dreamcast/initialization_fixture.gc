;; Callbacks for the unchanged original run-function-in-process (AI-assisted).
(defun dc-initialize-die ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (+ a0 a1 a2 a3 a4 a5))

(defun dc-initialize-return ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (rlet ((pp :reg r13 :type process))
    (set! (-> pp status) 'initialize-go))
  (+ a0 a1 a2 a3 a4 a5))

(defun dc-initialize-throw ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (rlet ((pp :reg r13 :type process))
    (set! (-> pp status) 'initialize-go))
  (throw 'initialize (the-as object (+ a0 a1 a2 a3 a4 a5)))
  (the uint 999))

(defun dc-initialize-protect ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (rlet ((pp :reg r13 :type process))
    (set! (-> pp status) 'initialize-go))
  (new 'stack 'protect-frame (the-as (function object) a5))
  (throw 'initialize (the-as object (+ a0 a1 a2 a3 a4)))
  (the uint 999))

(defun dc-initialize-error ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (rlet ((pp :reg r13 :type process))
    (set! (-> pp status) 'initialize-go))
  ((the-as (function object) a5))
  (the uint 123))

(defun dc-initialize-nested ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (rlet ((pp :reg r13 :type process))
    (set! (-> pp status) 'initialize-go))
  (let ((params (new 'stack-no-clear 'array 'uint64 6)))
    (set! (-> params 0) a0) (set! (-> params 1) a1)
    (set! (-> params 2) a2) (set! (-> params 3) a3)
    (set! (-> params 4) a4) (set! (-> params 5) a5)
    (new 'stack 'catch-frame 'dc-inner-tag dc-initialize-throw params))
  (the uint 999))

(defun dc-initialize-scoped ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (rlet ((pp :reg r13 :type process))
    (set! (-> pp status) 'initialize-go)
    (let ((old-pp pp))
      (set! pp (the-as process a5))
      (throw 'initialize (the-as object (+ a0 a1 a2 a3 a4)))
      (set! pp old-pp)))
  (the uint 999))
