;; Native call-site fault ABI probes (AI-assisted), ISC.
(define-extern dc-call-int-target (function int int))
(define-extern dc-call-float-target (function float float))
(define-extern dc-call-void-target (function int none))
(define-extern dc-call-eight-target (function int int int int int int int int int))
(define-extern dc-call-after int)
(define-extern dc-call-effects int)
(defun dc-call-guard-identity ((value int)) value)
(defun dc-call-guard-float-identity ((value float)) value)
(defun dc-call-guard-effect ((value int)) (set! dc-call-effects value) (none))
(defun dc-call-guard-last ((a int) (b int) (c int) (d int) (e int) (f int) (g int) (h int)) h)
(defun dc-call-guard-int ((value int))
  (let ((result (dc-call-int-target value))) (set! dc-call-after 1) (+ result 1)))
(defun dc-call-guard-float ((value float))
  (let ((result (dc-call-float-target value))) (set! dc-call-after 1) (+ result 1.5)))
(defun dc-call-guard-void ((value int))
  (dc-call-void-target value) (set! dc-call-after 1) (none))
(defun dc-call-guard-eight ((a int) (b int) (c int) (d int) (e int) (f int) (g int) (h int))
  (let ((result (dc-call-eight-target a b c d e f g h))) (set! dc-call-after 1) (+ result 1)))
(defun dc-call-guard-dynamic ((func (function int int)) (value int))
  (let ((result (func value))) (set! dc-call-after 1) (+ result 1)))
