;; Shared outer return destinations through the original frontend (AI-assisted).
(define dc-early-marker 0)
(defun dc-early-int ((arg int))
  (when (< arg 0) (return (- arg 7)))
  (when (= arg 42) (return 12345678901))
  (+ arg 9))
(defun dc-early-loop ((arg int))
  (local-vars (count int))
  (set! count 0)
  (while (< count arg)
    (when (= count 5) (return (+ count 100)))
    (1+! count))
  count)
(defun dc-early-float ((left float) (right float))
  (when (< left 0.0) (return right))
  left)
(defun dc-early-effect ((arg int))
  (set! dc-early-marker 11)
  (when (= arg 0) (return 7))
  (set! dc-early-marker 22)
  8)
(defun dc-early-object ((left object) (right object))
  (when (= left #f) (return right))
  left)
(defun dc-early-nested ((arg int))
  (+ 10 (block inner
          (when (= arg 3) (return-from inner 7))
          (when (= arg 4) (return 99))
          arg)))
(defun dc-early-eight ((a int) (b int) (c int) (d int) (e int) (f int) (g int) (h int))
  (when (< h 0) (return (+ a h)))
  (+ a b c d e f g h))
(defun dc-early-partial ((arg int))
  (local-vars (scratch int))
  (when (> arg 0) (return scratch))
  17)
(none)
