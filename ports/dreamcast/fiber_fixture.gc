;; Cooperative native bootstrap acceptance; no original scheduler. (AI-assisted)
(define-extern dc-c-fiber-yield (function int int))
(define-extern dc-fiber-pop (function object))
(defun dc-fiber-inner ((x int))
  (dc-fiber-pop)
  (+ x (dc-c-fiber-yield (+ x 3))))
(defun dc-fiber-main ()
  (let ((x 100))
    (dc-fiber-pop)
    (set! x (+ x (dc-c-fiber-yield 11)))
    (set! x (dc-fiber-inner x))
    (dc-fiber-pop)
    (+ x (dc-c-fiber-yield (+ x 7)) 9)))

