;; Real original frontend named-local and incoming-argument regressions (AI-assisted).
(defun dc-local-basic ((arg int))
  (local-vars (scratch int))
  (set! scratch (+ arg 1))
  scratch)
(defun dc-local-zero ()
  (local-vars (scratch int))
  (set! scratch 73)
  scratch)
(defun dc-local-mutate ((left int) (right int))
  (local-vars (copy int) (self int))
  (set! copy left)
  (set! left (+ left right))
  (set! self (- copy right))
  (+ left self))
(defun dc-local-eight ((a int) (b int) (c int) (d int) (e int) (f int) (g int) (h int))
  (local-vars (first int) (last int))
  (set! first (+ a b c d))
  (set! last (+ e f g h))
  (- first last))
(defun dc-local-float ((left float) (right float))
  (local-vars (scratch float))
  (set! scratch (+ left right))
  (* scratch 2.0))
(defun dc-local-branch ((arg int))
  (local-vars (result int))
  (if (>= arg 0)
    (set! result (+ arg 10))
    (set! result (- arg 10)))
  result)
(defun dc-local-uninitialized ((arg int))
  (local-vars (scratch int))
  (+ scratch arg))
(defun dc-local-partial ((arg int))
  (local-vars (scratch int))
  (when (> arg 0) (set! scratch 44))
  scratch)
(deftype dc-local-record (basic)
  ((value int32))
  (:methods (score (_type_) int))
  :no-inspect)
(defmethod score dc-local-record ((this dc-local-record))
  (local-vars (scratch int))
  (set! scratch (+ (-> this value) 13))
  scratch)
(deftype dc-local-process (basic) () :no-inspect)
(define dc-local-behavior
  (lambda :behavior dc-local-process ((arg int)) arg))
(deftype dc-local-auto (basic) ((value int32)))
(none)
