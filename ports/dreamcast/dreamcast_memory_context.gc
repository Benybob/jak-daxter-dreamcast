;;-*-Lisp-*-
;; Dreamcast target configuration: original console memory sizes (AI-assisted).
;; gcommon enables BIG_MEMORY, which (through PC_BIG_MEMORY) triples the shared
;; process heap behind every dead pool (PROCESS_HEAP_MULT 3, about 2.9 MiB). The
;; Dreamcast has 16 MiB of RAM in total, so this explicit context, preloaded after
;; gcommon and before gkernel-h, restores the original multiplier of 1. No original
;; body is changed. PC_PORT stays enabled. See TARGET_CONFIG_AUDIT.md.
(defglobalconstant BIG_MEMORY #f)
(defglobalconstant PC_BIG_MEMORY (and PC_PORT BIG_MEMORY))
