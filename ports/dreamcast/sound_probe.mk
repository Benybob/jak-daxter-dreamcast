# Sound probe snippet. Include beside Makefile; do not replace it.
# From ports/dreamcast, after sourcing KallistiOS environ.sh:
#   make -f Makefile -f sound_probe.mk jak-dc-sound-probe.elf
# The header is generated by the rule below. This file adds no "all" goal.

PYTHON ?= python3
SOUND_PROBE_TARGET := jak-dc-sound-probe.elf
SOUND_PROBE_OBJS := sound_probe_main.o aica_sfx.o

.PHONY: sound-probe-clean

build/sound_fixture.h: make_sound_fixture.py vag_adpcm.py
	mkdir -p build
	$(PYTHON) make_sound_fixture.py $@

sound_probe_main.o: sound_probe_main.c aica_sfx.h build/sound_fixture.h
	$(KOS_CC) $(KOS_CFLAGS) $(CFLAGS) -std=c99 -Wall -Wextra -I. -c sound_probe_main.c -o $@

aica_sfx.o: aica_sfx.c aica_sfx.h
	$(KOS_CC) $(KOS_CFLAGS) $(CFLAGS) -std=c99 -Wall -Wextra -c aica_sfx.c -o $@

$(SOUND_PROBE_TARGET): $(SOUND_PROBE_OBJS)
	kos-cc -o $@ $(SOUND_PROBE_OBJS)

sound-probe-clean:
	rm -f $(SOUND_PROBE_TARGET) $(SOUND_PROBE_OBJS) build/sound_fixture.h
