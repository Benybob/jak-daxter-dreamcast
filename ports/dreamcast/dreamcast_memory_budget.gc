;;-*-Lisp-*-
;; Dreamcast memory budget (AI-assisted): explicit target values for original
;; size constants that the engine defines inside the same file that uses them, so
;; a preloaded context cannot override them. The exporter's --batch mode replaces
;; the value of each (defconstant NAME ...) listed here wherever it appears in a
;; source, as the source is read; files on disk are unchanged, and each exported
;; IR records the names it substituted. An entry no source defines is reported
;; as stale. Reasons and measurements are in MEMORY_BUDGET.md.

;; display.gc: two per-frame PS2 DMA buffers. PC 2,664 KiB, PS2 1,712 KiB.
;; The original PS2 value, the size the original renderers fit a frame into.
;; To be revisited with the PowerVR renderer, which decides what they hold.
(defconstant DMA_BUFFER_GLOBAL_SIZE (* 1712 1024))

;; level.gc: each of the two level heaps alloc-levels! takes from the global
;; heap. PS2 10,416 KiB (debug 11,000 / 25,600 KiB). On Dreamcast a level keeps
;; only its logic BSP, art and allocations resident (LEVEL_PLAN.md: Geyser
;; Rock's logic BSP is 378,128 bytes); render data is drawn from converted
;; packages. Geyser Rock uses about 400 KB after birth (logic BSP plus entity
;; tables). 512 KiB each, both values, so level-get-for-use's debug allocation
;; and a compact allocation agree, and the player's art fits beside them.
(defconstant LEVEL_HEAP_SIZE (* 512 1024))
(defconstant LEVEL_HEAP_SIZE_DEBUG (* 512 1024))
