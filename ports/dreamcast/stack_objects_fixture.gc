;; Original frontend stack allocation and lifetime oracles (AI-assisted), ISC.
(in-package goal)
(deftype dc-stack-record (basic)
  ((value uint))
  (:methods (new (symbol type uint) dc-stack-record))
  :no-inspect)
(defmethod new dc-stack-record ((allocation symbol) (type-to-make type) (value uint))
  (let ((this (the dc-stack-record (&+ allocation *gtype-basic-offset*))))
    (set! (-> this type) type-to-make)
    (set! (-> this value) value)
    this))
(defun dc-stack-distinct ((a uint) (b uint))
  (let ((left (new 'stack-no-clear 'array 'uint64 2))
        (right (new 'stack-no-clear 'array 'uint64 2)))
    (set! (-> left 0) a) (set! (-> right 0) b)
    (set! (-> left 1) (+ a 1)) (set! (-> right 1) (+ b 2))
    (+ (-> left 0) (-> right 0) (-> left 1) (-> right 1))))
(defun dc-stack-alignment ()
  (let ((p (new 'stack-no-clear 'array 'uint64 2)))
    (logand (the-as uint p) 15)))
(defun dc-stack-high-word ()
  (let ((p (new 'stack-no-clear 'array 'uint64 2)))
    (shr (the-as uint p) 32)))
(defun dc-stack-bounds ()
  (let ((a (new 'stack-no-clear 'array 'uint64 4))
        (b (new 'stack-no-clear 'array 'uint64 4)))
    (set! (-> a 0) 1) (set! (-> a 3) 2)
    (set! (-> b 0) 4) (set! (-> b 3) 8)
    (+ (-> a 0) (-> a 3) (-> b 0) (-> b 3))))
(defun dc-stack-boxed ((v uint))
  (let ((p (new 'stack 'dc-stack-record v)))
    (+ (-> p value) 1)))
(defun dc-stack-sum4 ((a uint) (b uint) (c uint) (d uint)) (+ a b c d))
(defun dc-stack-outgoing ((a uint) (b uint) (c uint) (d uint))
  (let ((p (new 'stack-no-clear 'array 'uint64 1)))
    (set! (-> p 0) a)
    (+ (dc-stack-sum4 b c d (the uint 7)) (-> p 0))))
(defun dc-stack-touch ((n uint) (f float)) (+ n (the uint f)))
(defun dc-stack-mixed ((n uint) (f float))
  (let ((p (new 'stack-no-clear 'array 'uint64 2)))
    (set! (-> p 0) n) (set! (-> p 1) (+ n 3))
    (+ (dc-stack-touch n f) (-> p 0) (-> p 1) (dc-stack-touch n f))))
(defun dc-stack-spill ((a uint) (b uint) (c uint) (d uint) (e uint) (f uint))
  (let ((p (new 'stack-no-clear 'array 'uint64 1)))
    (set! (-> p 0) 100)
    (+ a b c d e f (-> p 0))))
(defun dc-stack-plus-one ((n uint)) (+ n 1))
(defun dc-stack-lexical ((target process) (v uint) (fn (function uint uint)))
  (rlet ((pp :reg r13 :type process))
    (let ((old-pp pp) (p (new 'stack-no-clear 'array 'uint64 1)))
      (set! (-> p 0) v)
      (set! pp target)
      (let ((value (fn v)))
        (set! pp old-pp)
        (+ value (-> p 0))))))
(defun dc-stack-suspend ((v uint))
  (let ((p (new 'stack-no-clear 'array 'uint64 2)))
    (set! (-> p 0) v) (set! (-> p 1) (+ v 7))
    (suspend)
    (+ (-> p 0) (-> p 1))))
