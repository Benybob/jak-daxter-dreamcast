;; No-result startup and calls through the original frontend (AI-assisted).
(define dc-void-state 0)
(defun dc-void-write ((value int))
  (set! dc-void-state value)
  (none))
(defun dc-void-clear ()
  (set! dc-void-state 0)
  (none))
(defun dc-void-add ((value int))
  (set! dc-void-state (+ dc-void-state value))
  (none))
(defun dc-void-empty () (none))
(defun dc-void-read () dc-void-state)
(defun dc-void-call ((value int))
  (dc-void-write value)
  (none))
(defun dc-void-call-read ((value int))
  (let ((live (+ value 7)))
    (dc-void-write (+ value 3))
    (+ live dc-void-state)))
(defun dc-void-dispatch ((callback (function int none)) (value int))
  (callback value)
  (none))
(dc-void-call 73)
(none)
