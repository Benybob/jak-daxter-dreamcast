;; Explicit original desktop fixed-register roles; native mapping is separate (AI-assisted).
(defun dc-fixed-read ()
  (rlet ((st :reg r14 :reset-here #t :type uint)) st))
(defun dc-fixed-low ()
  (rlet ((st :reg r14 :reset-here #t :type uint)) (- st 32768)))
(defun dc-fixed-high ()
  (rlet ((st :reg r14 :reset-here #t :type uint)) (+ st 32768)))
(defun dc-fixed-alias ((arg int))
  (let ((first (rlet ((st :reg r14 :reset-here #t :type uint)) st)))
    (rlet ((again :reg r14 :reset-here #t :type uint)) (+ first again arg))))
(defun dc-fixed-mutation ()
  (rlet ((st :reg r14 :reset-here #t :type uint)) (set! st (the uint 7)) st))
(defun dc-fixed-uninitialized ()
  (rlet ((st :reg r14 :type uint)) st))
(defun dc-fixed-unknown ()
  (rlet ((offset :reg r15 :reset-here #t :type uint)) offset))
(none)
