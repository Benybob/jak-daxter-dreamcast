;; Original EnumType scalar ABI regressions (AI-assisted), ISC.
(defenum dc-enum-mask32 :type uint32 :bitfield #t (low 0) (high 31))
(defenum dc-enum-mask64 :type uint64 :bitfield #t (low 0) (mid 32) (high 63))
(defenum dc-enum-signed32 :type int32 (negative -1) (positive 7))
(defenum dc-enum-signed64 :type int64 (negative -1) (positive 7))
(defenum dc-enum-mask8 :type uint8 :bitfield #t (low 0) (high 7))
(defenum dc-enum-mask16 :type uint16 :bitfield #t (low 0) (high 15))
(defenum dc-enum-signed8 :type int8 (negative -1) (positive 7))
(defenum dc-enum-signed16 :type int16 (negative -1) (positive 7))
(defun dc-enum-u32 ((value dc-enum-mask32)) value)
(defun dc-enum-u64 ((value dc-enum-mask64)) value)
(defun dc-enum-s32 ((value dc-enum-signed32)) value)
(defun dc-enum-s64 ((value dc-enum-signed64)) value)
(defun dc-enum-call ((a dc-enum-mask64) (b dc-enum-signed32))
  (logxor (the uint (dc-enum-u64 a)) (the uint (dc-enum-s32 b))))
(defun dc-enum-mixed ((f float) (a dc-enum-mask32) (g float) (b dc-enum-mask64))
  (+ (the uint a) (the uint b) (the uint f) (the uint g)))
(defun dc-enum-mixed-call ((a dc-enum-mask32) (b dc-enum-mask64))
  (dc-enum-mixed 1.0 a 2.0 b))
(defun dc-enum-load-u32 ((p (pointer dc-enum-mask32))) (-> p))
(defun dc-enum-load-s32 ((p (pointer dc-enum-signed32))) (-> p))
(defun dc-enum-load-u64 ((p (pointer dc-enum-mask64))) (-> p))
(defun dc-enum-load-s64 ((p (pointer dc-enum-signed64))) (-> p))
(defun dc-enum-bits32 () (dc-enum-mask32 low high))
(defun dc-enum-bits64 () (dc-enum-mask64 low mid high))
(defun dc-enum-mixed-stack ((a dc-enum-mask32) (f float) (b dc-enum-mask64) (c dc-enum-mask32))
  (+ (the uint a) (the uint b) (the uint c)))
(defun dc-enum-u8 ((value dc-enum-mask8)) value)
(defun dc-enum-u16 ((value dc-enum-mask16)) value)
(defun dc-enum-s8 ((value dc-enum-signed8)) value)
(defun dc-enum-s16 ((value dc-enum-signed16)) value)
(defun dc-enum-load-u8 ((p (pointer dc-enum-mask8))) (-> p))
(defun dc-enum-load-s8 ((p (pointer dc-enum-signed8))) (-> p))
(defun dc-enum-load-u16 ((p (pointer dc-enum-mask16))) (-> p))
(defun dc-enum-load-s16 ((p (pointer dc-enum-signed16))) (-> p))
(none)
